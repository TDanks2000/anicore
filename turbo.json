{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": [
    "ANICORE_*",
    "DATABASE_URL",
    "PORT",
    "HOST",
    "CORS_ORIGIN",
    "TMDB_API_KEY",
    "TVDB_API_KEY",
    "TVDB_PIN",
    "VITE_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^typecheck", "typecheck"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    }
  }
}
