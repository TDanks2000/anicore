{
  "name": "@anicore/api",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc --noEmit",
    "db:audit-mappings": "bun src/scripts/audit-mappings-command.ts",
    "db:backfill-provider-mappings": "bun src/scripts/backfill-provider-mappings.ts",
    "db:diagnose-provider-collision-coverage": "bun src/scripts/diagnose-provider-collision-coverage.ts",
    "db:diagnose-provider-collision-identities": "bun src/scripts/diagnose-provider-collision-identities.ts",
    "db:diagnose-provider-local-count-mismatches": "bun src/scripts/diagnose-provider-local-count-mismatches.ts",
    "db:diagnose-provider-season-ownership": "bun src/scripts/diagnose-provider-season-ownership.ts",
    "db:plan-jojo-segment-migration": "bun src/scripts/plan-jojo-segment-migration.ts",
    "db:plan-provider-collision-segments": "bun src/scripts/plan-provider-collision-segments.ts",
    "db:plan-provider-dual-segments": "bun src/scripts/plan-provider-dual-segments.ts",
    "db:plan-provider-season-ownership-repairs": "bun src/scripts/plan-provider-season-ownership-repairs.ts",
    "db:repair-jojo-segment-migration": "bun src/scripts/repair-jojo-segment-migration.ts",
    "db:repair-mappings": "bun src/scripts/repair-mappings.ts",
    "db:repair-provider-season-ownership": "bun src/scripts/repair-provider-season-ownership.ts",
    "db:repair-tvdb-orphans": "bun src/scripts/repair-tvdb-orphans.ts",
    "db:check-shape": "bun src/scripts/check-db-shape.ts",
    "db:empty": "bun src/scripts/empty-db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun src/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "dev": "bun --cwd ../.. --watch --preload ./scripts/api-cwd.ts apps/api/src/index.ts",
    "start": "bun src/index.ts",
    "sync": "bun src/scripts/sync.ts",
    "sync:anilist": "bun src/scripts/sync-anilist.ts",
    "sync:audio": "bun src/scripts/sync-audio-status.ts",
    "sync:dry": "bun src/scripts/sync.ts --dry-run",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "@anicore/db": "workspace:*",
    "@anicore/providers": "workspace:*",
    "@anicore/sync-monitor": "workspace:*",
    "@api-wrappers/anilist-wrapper": "catalog:",
    "@api-wrappers/tmdb-wrapper": "catalog:",
    "@elysia/cors": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "bun-types": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
