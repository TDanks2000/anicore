# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# "require" (default) or "disable" for a local Postgres without TLS.
ANICORE_DATABASE_SSL=require

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=3000
HOST=localhost
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Required for every write and every /admin route. Unset = those routes return 503.
ANICORE_ADMIN_TOKEN=

# ── Sync monitor and scheduler ───────────────────────────────────────────────
ANICORE_SYNC_MONITOR=
ANICORE_SYNC_MONITOR_CODE=
ANICORE_SYNC_MONITOR_DIR=data/sync-monitor
# Set to false to keep the automatic sync scheduler off regardless of saved config.
ANICORE_AUTO_SYNC_ENABLED=true

# ── Episode enrichment providers ─────────────────────────────────────────────
TMDB_API_KEY=
TVDB_API_KEY=
TVDB_PIN=

# ── Outbound proxy (optional) ────────────────────────────────────────────────
ANICORE_PROXY_URL=
ANICORE_USE_FREE_PROXY=
ANICORE_FREE_PROXY_MAX_ATTEMPTS=25

# ── Tests (optional) ─────────────────────────────────────────────────────────
# A disposable database whose name contains "test"; integration tests truncate it.
TEST_DATABASE_URL=
