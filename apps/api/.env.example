# ── Database ─────────────────────────────────────────────────────────────────
# Local SQLite file. Leave unset to use apps/api/data/anicore.db; it is created
# and migrated automatically on first use. Accepts a path or a file: URL.
DATABASE_URL=

# ── HTTP server ──────────────────────────────────────────────────────────────
PORT=3000
HOST=localhost
# Comma-separated browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173
# Where cross-origin request lines are appended. Defaults to apps/api/data/logs/cors.log.
ANICORE_CORS_LOG=
# Required for every write and every /admin route. Unset = those routes return 503.
ANICORE_ADMIN_TOKEN=

# ── Sync monitor and scheduler ───────────────────────────────────────────────
ANICORE_SYNC_MONITOR=
ANICORE_SYNC_MONITOR_CODE=
ANICORE_SYNC_MONITOR_DIR=data/sync-monitor
# Set to false to keep the automatic sync scheduler off regardless of saved config.
ANICORE_AUTO_SYNC_ENABLED=true

# ── Episode enrichment providers ─────────────────────────────────────────────
TMDB_API_KEY=
TVDB_API_KEY=
TVDB_PIN=

# ── Outbound proxy (optional) ────────────────────────────────────────────────
ANICORE_PROXY_URL=
ANICORE_USE_FREE_PROXY=
ANICORE_FREE_PROXY_MAX_ATTEMPTS=25
