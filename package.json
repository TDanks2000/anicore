    "db:plan-provider-collision-segments": "turbo run db:plan-provider-collision-segments --filter=@anicore/api --ui=stream --",
    "db:plan-provider-dual-segments": "turbo run db:plan-provider-dual-segments --filter=@anicore/api --ui=stream --",
