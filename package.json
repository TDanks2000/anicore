{
  "name": "anicore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@api-wrappers/anilist-wrapper": "^2.7.0",
      "@api-wrappers/tmdb-wrapper": "^2.2.0",
      "@elysia/cors": "^1.3.3",
      "@elysia/openapi": "^1.4.16",
      "@radix-ui/react-slot": "^1.1.1",
      "@tailwindcss/vite": "^4.1.11",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@vitejs/plugin-react": "^4.6.0",
      "bun-types": "^1.3.14",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-kit": "^0.31.10",
      "drizzle-orm": "^0.45.2",
      "elysia": "^1.4.29",
      "lucide-react": "^0.468.0",
      "postgres": "^3.4.5",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "tailwind-merge": "^2.6.0",
      "tailwindcss": "^4.1.11",
      "typescript": "^7.0.2",
      "vite": "^6.0.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev --ui=stream",
    "dev:api": "turbo run dev --filter=@anicore/api --ui=stream",
    "dev:web": "turbo run dev --filter=@anicore/web --ui=stream",
    "start": "turbo run start --ui=stream",
    "build": "turbo run build --ui=stream",
    "typecheck": "turbo run typecheck --ui=stream",
    "test": "turbo run test --ui=stream",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:audit-mappings": "cd apps/api && bun run db:audit-mappings --",
    "db:backfill-provider-mappings": "cd apps/api && bun run db:backfill-provider-mappings --",
    "db:check-shape": "cd apps/api && bun run db:check-shape --",
    "db:diagnose-ambiguous-provider-mappings": "cd apps/api && bun run db:diagnose-ambiguous-provider-mappings --",
    "db:diagnose-provider-collision-coverage": "cd apps/api && bun run db:diagnose-provider-collision-coverage --",
    "db:diagnose-provider-collision-identities": "cd apps/api && bun run db:diagnose-provider-collision-identities --",
    "db:diagnose-provider-local-count-mismatches": "cd apps/api && bun run db:diagnose-provider-local-count-mismatches --",
    "db:diagnose-provider-season-ownership": "cd apps/api && bun run db:diagnose-provider-season-ownership --",
    "db:empty": "cd apps/api && bun run db:empty --",
    "db:generate": "cd apps/api && bun run db:generate --",
    "db:migrate": "cd apps/api && bun run db:migrate --",
    "db:plan-provider-collision-segments": "cd apps/api && bun run db:plan-provider-collision-segments --",
    "db:plan-provider-dual-segments": "cd apps/api && bun run db:plan-provider-dual-segments --",
    "db:plan-provider-season-ownership-repairs": "cd apps/api && bun run db:plan-provider-season-ownership-repairs --",
    "db:push": "cd apps/api && bun run db:push --",
    "db:repair-ambiguous-mapping-primaries": "cd apps/api && bun run db:repair-ambiguous-mapping-primaries --",
    "db:repair-mappings": "cd apps/api && bun run db:repair-mappings --",
    "db:repair-provider-season-ownership": "cd apps/api && bun run db:repair-provider-season-ownership --",
    "db:repair-tvdb-orphans": "cd apps/api && bun run db:repair-tvdb-orphans --",
    "db:seed": "cd apps/api && bun run db:seed --",
    "db:studio": "cd apps/api && bun run db:studio --",
    "sync": "cd apps/api && bun run sync --",
    "sync:anilist": "cd apps/api && bun run sync:anilist --",
    "sync:audio": "cd apps/api && bun run sync:audio --",
    "sync:dry": "cd apps/api && bun run sync:dry --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "bun-types": "^1.3.14",
    "turbo": "^2.10.4",
    "typescript": "^7.0.2"
  }
}
