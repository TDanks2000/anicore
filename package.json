{
  "name": "anicore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@api-wrappers/anilist-wrapper": "^2.7.0",
      "@api-wrappers/tmdb-wrapper": "^2.2.0",
      "@elysia/cors": "^1.3.3",
      "@radix-ui/react-slot": "^1.1.1",
      "@tailwindcss/vite": "^4.1.11",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0",
      "@vitejs/plugin-react": "^4.6.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "drizzle-kit": "latest",
      "drizzle-orm": "latest",
      "elysia": "latest",
      "lucide-react": "^0.468.0",
      "postgres": "^3.4.5",
      "react": "^19.0.0",
      "react-dom": "^19.0.0",
      "tailwind-merge": "^2.6.0",
      "tailwindcss": "^4.1.11",
      "bun-types": "latest",
      "typescript": "latest",
      "vite": "^6.0.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev --ui=stream",
