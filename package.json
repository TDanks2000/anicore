    "db:diagnose-provider-collision-coverage": "turbo run db:diagnose-provider-collision-coverage --filter=@anicore/api --ui=stream --",
    "db:diagnose-provider-collision-identities": "turbo run db:diagnose-provider-collision-identities --filter=@anicore/api --ui=stream --",
    "db:diagnose-provider-local-count-mismatches": "turbo run db:diagnose-provider-local-count-mismatches --filter=@anicore/api --ui=stream --",
