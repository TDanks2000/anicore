    "db:repair-air-recap-repair": "turbo run db:repair-air-recap-repair --filter=@anicore/api --ui=stream --",
    "db:repair-jojo-segment-migration": "turbo run db:repair-jojo-segment-migration --filter=@anicore/api --ui=stream --",
    "db:repair-mappings": "turbo run db:repair-mappings --filter=@anicore/api --ui=stream --",
    "db:repair-provider-season-ownership": "turbo run db:repair-provider-season-ownership --filter=@anicore/api --ui=stream --",
    "db:repair-tvdb-orphans": "turbo run db:repair-tvdb-orphans --filter=@anicore/api --ui=stream --",
    "db:generate": "turbo run db:generate --filter=@anicore/api --ui=stream",
    "db:migrate": "turbo run db:migrate --filter=@anicore/api --ui=stream",
    "db:push": "turbo run db:push --filter=@anicore/api --ui=stream",
